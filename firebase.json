{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "HOSTING.md"
    ],
    "headers": [
      {
        "source": "index.py",
        "headers": [
          { "key": "Content-Disposition", "value": "attachment" }
        ]
      },
      {
        "source": "phpbb.txt",
        "headers": [
          { "key": "Content-Disposition", "value": "attachment" }
        ]
      }
    ]
  }
}
